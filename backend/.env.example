# Copy to .env and adjust. All values consumed via @nestjs/config.

# --- HTTP ---
PORT=5000
# Comma-separated allowed origins for CORS (BACKEND.md §10.1).
# The web client is Next.js on :3001; the Flutter web build runs on :8080.
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# --- Database (BACKEND.md §1: PostgreSQL) ---
# Also read by database/run-sql.mjs (db:setup / db:reset).
DATABASE_URL=postgres://thuie:thuie@localhost:5432/thuie

# --- Auth (BACKEND.md §3) ---
JWT_SECRET=change-me-access-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Event tickets (BACKEND.md §6.10): HMAC over event_id|user_id|exp|nonce ---
TICKET_SECRET=change-me-ticket-secret
TICKET_TTL_MIN=10

# --- Media (BACKEND.md §8): MVP local-disk storage behind a presigned-S3 seam ---
MEDIA_DIR=./uploads
# 10 MB images / 5 MB avatars / 25 MB attachments (§8.2)

# --- OTP (BACKEND.md §3.2) ---
OTP_TTL_MIN=10
# Dev mode: log the OTP code instead of sending SMS/email
OTP_DEV_MODE=true
